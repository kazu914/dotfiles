{
  "id": "root",
  "cloned_from": {
    "name": "main",
    "version": "0.1.11"
  },
  "type": "column",
  "children": [
    {
      "id": "tabs",
      "type": "block",
      "content": {
        "mod": "my-tabs"
      },
      "size": {
        "px": 38
      },
      "window_drag": true
    },
    {
      "id": "body",
      "type": "row",
      "divider": {
        "width": 1,
        "color": "border"
      },
      "children": [
        {
          "id": "sidebar",
          "type": "column",
          "children": [
            {
              "id": "sidebar-lists",
              "type": "column",
              "children": [
                {
                  "id": "spaces",
                  "type": "block",
                  "content": {
                    "mod": "spaces"
                  },
                  "size": {
                    "weight": 1
                  },
                  "min": 90
                },
                {
                  "id": "agents",
                  "type": "block",
                  "content": {
                    "mod": "agents"
                  },
                  "size": {
                    "weight": 1
                  },
                  "min": 90
                }
              ]
            },
            {
              "id": "sidebar-footer",
              "type": "block",
              "content": {
                "mod": "workspace-chrome",
                "props": {
                  "footer": true
                }
              },
              "size": {
                "px": 69
              }
            },
            {
              "id": "tab-actions",
              "type": "block",
              "content": {
                "mod": "tab-actions"
              },
              "size": {
                "px": 8
              }
            }
          ],
          "size": {
            "px": 268
          },
          "min": 44,
          "max": 480,
          "background": "chrome",
          "resizable": false
        },
        {
          "id": "work-body",
          "type": "row",
          "children": [
            {
              "id": "main",
              "type": "block",
              "content": {
                "tab": "active",
                "pane": {
                  "header": {
                    "content": {
                      "mod": "pane"
                    },
                    "reveal": "always",
                    "height": 30,
                    "position": "top"
                  },
                  "background": "background",
                  "border": {
                    "width": 1,
                    "color": "border"
                  },
                  "focus": {
                    "width": 1,
                    "color": "accent"
                  },
                  "radius": 10,
                  "gap": 8,
                  "lone": true
                }
              }
            },
            {
              "id": "panel",
              "type": "column",
              "children": [
                {
                  "id": "panel-body",
                  "type": "stack",
                  "children": [
                    {
                      "id": "files",
                      "type": "block",
                      "content": {
                        "mod": "files"
                      }
                    },
                    {
                      "id": "changes",
                      "type": "block",
                      "content": {
                        "mod": "changes"
                      }
                    }
                  ],
                  "active": "files"
                }
              ],
              "size": {
                "px": 368
              },
              "min": 280,
              "max": 900,
              "hidden": true
            }
          ],
          "padding": 8,
          "gap": 8
        }
      ]
    }
  ],
  "background": "canvas",
  "terminal_padding": [
    14,
    12
  ],
  "titlebar": "none",
  "traffic_lights": [
    12,
    13
  ]
}
